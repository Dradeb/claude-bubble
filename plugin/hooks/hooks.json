{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/s",
              "/c",
              "curl.exe -s --connect-timeout 0.4 -m 590 -X POST --data-binary @- http://127.0.0.1:47800/hook & exit /b 0"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/s",
              "/c",
              "curl.exe -s --connect-timeout 0.4 -m 590 -X POST --data-binary @- http://127.0.0.1:47800/hook & exit /b 0"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/s",
              "/c",
              "curl.exe -s --connect-timeout 0.4 -m 590 -X POST --data-binary @- http://127.0.0.1:47800/hook & exit /b 0"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/s",
              "/c",
              "curl.exe -s --connect-timeout 0.4 -m 590 -X POST --data-binary @- http://127.0.0.1:47800/hook & exit /b 0"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/s",
              "/c",
              "curl.exe -s --connect-timeout 0.4 -m 590 -X POST --data-binary @- http://127.0.0.1:47800/hook & exit /b 0"
            ],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
